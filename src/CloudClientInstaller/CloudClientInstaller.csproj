<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 and 11: the installer is one small exe with nothing to install first. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>CloudClient.Installer</RootNamespace>
    <DebugType>embedded</DebugType>

    <!-- One installer per brand, like the app: -p:Brand=WebinCloud or RyzhellCloud (see Directory.Build.props). -->
    <AssemblyName>$(Brand)Installer</AssemblyName>
    <ApplicationIcon>..\..\branding\$(Brand)\app.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);BRAND_$(Brand.ToUpperInvariant())</DefineConstants>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Brand)' == 'WebinCloud'">
    <Product>Webin Cloud Installer</Product>
    <Company>Webin Cloud</Company>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Brand)' == 'RyzhellCloud'">
    <Product>Ryzhell Cloud Installer</Product>
    <Company>Ryzhell Cloud</Company>
  </PropertyGroup>

  <Target Name="CheckBrand" BeforeTargets="BeforeBuild">
    <Error Condition="'$(Brand)' != 'WebinCloud' And '$(Brand)' != 'RyzhellCloud'" Text="Unknown Brand '$(Brand)'. Use WebinCloud or RyzhellCloud." />
  </Target>

  <!-- The WPF SDK drops these from the implicit usings. -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Windows' own API for File Explorer's cloud drives (StorageProviderSyncRootManager), from .NET Framework.
       It calls into Windows: nothing extra ships with the exe. 17763 = Windows 10 1809, the app's minimum. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.17763.1000" />
  </ItemGroup>

  <!-- Shared with the app: the brand, where its releases live, the key that signs them and the card shape. -->
  <ItemGroup>
    <Compile Include="..\CloudClient\Brand.cs" Link="Shared\Brand.cs" />
    <Compile Include="..\CloudClient\Updates\UpdateSource.cs" Link="Shared\UpdateSource.cs" />
    <Compile Include="..\CloudClient\Updates\UpdateKey.cs" Link="Shared\UpdateKey.cs" />
    <Compile Include="..\CloudClient\UI\Controls\ChamferBorder.cs" Link="Shared\ChamferBorder.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\CloudClient\Assets\Fonts\Rajdhani-Bold.ttf;..\CloudClient\Assets\Fonts\Rajdhani-SemiBold.ttf;..\CloudClient\Assets\Fonts\Rajdhani-Medium.ttf"
              Link="Assets\Fonts\%(Filename)%(Extension)" />
    <Resource Include="..\..\branding\$(Brand)\app.ico" Link="Brand\app.ico" />
    <Resource Include="..\..\branding\$(Brand)\icon.png" Link="Brand\icon.png" />
    <!-- Webin Cloud Server's logo, for the page that checks the release on it (the same in both brands). -->
    <Resource Include="..\..\branding\WebinCloud\icon.png" Link="Assets\webincloud.png" />
  </ItemGroup>

</Project>
